# CapNet 환경변수 예시.  cp .env.example .env  후 값을 채운다.
#
# compose.yaml 단독(데모·심사)은 이 파일 없이도 돈다 — 기본값이 박혀 있다.
# compose.prod.yaml(제품)은 아래 필수 항목이 없으면 **기동하지 않는다.** 의도된 것이다.

# ── DB (제품에서 필수) ────────────────────────────────────────────────
POSTGRES_USER=capnet
# 기본값 capnet 을 그대로 쓰지 않는다.  openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=capnet
DATABASE_URL=postgresql://capnet:<POSTGRES_PASSWORD>@postgres:5432/capnet

# ── 포트 ──────────────────────────────────────────────────────────────
CORE_PORT=8000
NODE_PORT=8001

# ── 마이그레이션 ──────────────────────────────────────────────────────
# 1 = compose 가 일회성 migrate 서비스로 자동 적용 (데모 기본값)
# 0 = 끄고 운영자가 scripts/migrate.sh up 을 직접 돌린다 (제품 기본값)
CAPNET_AUTO_MIGRATE=1

# ── 정문 (제품에서 켠다 — compose.prod.yaml 이 강제로 1 로 둔다) ───────
# 0 이면 관리 API 쓰기 경로가 인증 없이 열려 있다. 신뢰 네트워크 밖에 Core 를 두면 반드시 1.
REQUIRE_API_KEY=0
# 0 이면 아무나 Node 를 사칭해 배정을 가져갈 수 있다.
REQUIRE_NODE_CREDENTIAL=0

# ── 운영 스크립트가 쓰는 관리 API 키 ──────────────────────────────────
# 발급:  docker compose exec core python -m app.apikey_cli issue --role admin --label bootstrap
# 값을 여기 적지 말고 파일로 두는 편이 낫다 (docker inspect 에 안 뜬다):
#   CAPNET_API_KEY_FILE=./data/admin.key
# 둘 다 있으면 CAPNET_API_KEY 가 이긴다. 이 파일은 커밋하지 않는다.
CAPNET_API_KEY=
CAPNET_API_KEY_FILE=

# ── DB 커넥션 풀 (SD-017) ─────────────────────────────────────────────
DB_POOL=1
DB_POOL_MIN=1
DB_POOL_MAX=8
